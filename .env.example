# Docker Dev Hub shared settings
POSTGRES_DB=devhub
POSTGRES_USER=test
POSTGRES_PASSWORD=test
POSTGRES_PORT=5432

REDIS_PORT=6379
# Optional existing ACL file inside the Redis data volume. Never commit its secrets.
REDIS_ACL_FILE=

MEILI_IMAGE=getmeili/meilisearch:v1.48
MEILI_MASTER_KEY=masterKey
MEILI_PORT=7700

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

ADMINER_PORT=9080
DOZZLE_PORT=8888

# Profile proxy (devhub up --with proxy): http://<project>.localhost
CADDY_HTTP_PORT=80
CADDY_ADMIN_PORT=2019

MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=trading
MYSQL_USER=test
MYSQL_PASSWORD=test

MARIADB_PORT=3307
MARIADB_ROOT_PASSWORD=root

RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# Feature environment settings are read from the operator process environment.
# export DEVHUB_FEATURE_MAX_ACTIVE=5
# export DEVHUB_FEATURE_MAX_BUILDS=2
# export DEVHUB_FEATURE_MIN_FREE_MIB=2048
# export DEVHUB_FEATURE_PROXY_PORT=80
# export DEVHUB_RECIPE_DIR=/absolute/path/to/recipes
# export DEVHUB_WORKTREE_ROOT=/absolute/path/to/private/worktrees
