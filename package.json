{
  "name": "devhub",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:build": "tailwindcss -i ./docs/input.css -o ./docs/styles.css --minify",
    "docs:watch": "tailwindcss -i ./docs/input.css -o ./docs/styles.css --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test:backend": "bun test src",
    "devhub": "bun src/main.ts",
    "web:dev": "vite --config apps/web/vite.config.ts",
    "web:build": "vite build --config apps/web/vite.config.ts"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "^4.3.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "4.13.14",
    "lucide-react": "1.63.0",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "yaml": "2.9.1"
  }
}
