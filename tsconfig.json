{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "tools/**/*.ts"
  ],
  "exclude": [
    "apps",
    "node_modules"
  ]
}
