#!/usr/bin/env bash
set -euo pipefail

resolve_script_path() {
  local source="${BASH_SOURCE[0]}"
  while [ -L "$source" ]; do
    local dir
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ "$source" != /* ]] && source="$dir/$source"
  done
  cd -P "$(dirname "$source")" && pwd
}

SCRIPT_DIR="$(resolve_script_path)"
DEVHUB_CHECKOUT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
DEVHUB_DIR_DEFAULT="$DEVHUB_CHECKOUT_DIR"
DEVHUB_DIR="${DEVHUB_DIR:-$DEVHUB_DIR_DEFAULT}"
COMPOSE_FILE="$DEVHUB_DIR/compose.yml"
ENV_FILE="$DEVHUB_DIR/.env"
VERSION_FILE="$DEVHUB_DIR/VERSION"
SCRIPTS_DIR="$DEVHUB_DIR/data/scripts"
NETWORK_NAME="${DEVHUB_NETWORK:-dev-shared-net}"
DEFAULT_PROFILES=(core async)
ALL_PROFILES="core,async,proxy"
STARTABLE_PROFILES="$ALL_PROFILES"
POSTGRES_CONTAINER="${POSTGRES_CONTAINER:-infra-postgres}"
INSTANCE_LABEL="devhub.service-instance"

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "Missing required command: $1" >&2
    exit 1
  }
}

ensure_files() {
  [ -f "$COMPOSE_FILE" ] || { echo "Compose file not found: $COMPOSE_FILE" >&2; exit 1; }
  if [ ! -f "$ENV_FILE" ] && [ -f "$DEVHUB_DIR/.env.example" ]; then
    cp "$DEVHUB_DIR/.env.example" "$ENV_FILE"
    echo "Created $ENV_FILE from .env.example"
  fi
  [ -f "$ENV_FILE" ] || { echo "Env file not found: $ENV_FILE" >&2; exit 1; }
}

dc() {
  docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "$@"
}

ensure_network() {
  if ! docker network inspect "$NETWORK_NAME" >/dev/null 2>&1; then
    docker network create "$NETWORK_NAME" >/dev/null
    echo "Network created: $NETWORK_NAME"
  fi
}

join_profiles() {
  local IFS=,
  echo "$*"
}

profile_allowed() {
  local needle="$1"
  [[ ",$STARTABLE_PROFILES," == *",$needle,"* ]]
}

open_url() {
  local url="$1"
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 &
  elif command -v open >/dev/null 2>&1; then
    open "$url" >/dev/null 2>&1 &
  fi
  echo "$url"
}

compose_config() {
  COMPOSE_PROFILES="$ALL_PROFILES" dc config --format json
}

print_ports() {
  local config="$1" ports pattern
  echo "Configured bindings:"
  jq -r '.services[] | .ports[]? | "\(.host_ip):\(.published) -> \(.target)/\(.protocol)"' <<<"$config"
  ports=$(jq -r '[.services[] | .ports[]?.published] | unique | join("|")' <<<"$config")
  [ -n "$ports" ] || return 0
  pattern=":($ports)([[:space:]]|$)"
  if command -v ss >/dev/null 2>&1; then
    ss -ltn | awk -v pattern="$pattern" 'NR==1 || $0 ~ pattern'
  elif command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP -sTCP:LISTEN | awk -v pattern="$pattern" 'NR==1 || $0 ~ pattern'
  else
    echo "Neither 'ss' nor 'lsof' found; skipping host port inspection."
  fi
}

# Other versions of a shared service: DevHub creates them on demand, outside compose.yml.
service_instances() {
  docker ps -q "$@" --filter "label=$INSTANCE_LABEL"
}

cmd_up() {
  local requested=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --with)
        [ $# -ge 2 ] || { echo "--with requires a value" >&2; exit 1; }
        IFS=',' read -r -a extra <<<"$2"
        for p in "${extra[@]}"; do
          requested+=("$p")
        done
        shift 2
        ;;
      *)
        echo "Unknown option for up: $1" >&2
        exit 1
        ;;
    esac
  done

  local profiles=("${DEFAULT_PROFILES[@]}")
  for p in "${requested[@]}"; do
    case "$p" in
      '') ;;
      *)
        if ! profile_allowed "$p"; then
          echo "Unknown profile: $p (allowed: $STARTABLE_PROFILES)" >&2
          exit 1
        fi
        # shellcheck disable=SC2076  # literal substring match is intended
        if [[ ! " ${profiles[*]} " =~ " ${p} " ]]; then
          profiles+=("$p")
        fi
        ;;
    esac
  done

  ensure_network
  local profile_csv
  profile_csv="$(join_profiles "${profiles[@]}")"
  COMPOSE_PROFILES="$profile_csv" dc up -d
  # A failing instance must not stop the reconnect below, or every project would lose its services.
  service_instances -a | xargs -r docker start >/dev/null || echo "Some service instances did not start; check devhub ps" >&2
  "$SCRIPTS_DIR/reconnect-project-networks.sh"
  echo "Running profiles: $profile_csv"
}

cmd_down() {
  COMPOSE_PROFILES="$ALL_PROFILES" dc down
  service_instances | xargs -r docker stop >/dev/null || echo "Some service instances did not stop; check devhub ps" >&2
}

cmd_restart() {
  cmd_down
  cmd_up "$@"
}

cmd_ps() {
  COMPOSE_PROFILES="$ALL_PROFILES" dc ps
  docker ps -a --filter "label=$INSTANCE_LABEL" --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}'
}

cmd_logs() {
  if [ $# -gt 0 ]; then
    COMPOSE_PROFILES="$ALL_PROFILES" dc logs -f "$1"
  else
    COMPOSE_PROFILES="$ALL_PROFILES" dc logs -f
  fi
}

cmd_open() {
  local target="${1:-}" service port published config
  case "$target" in
    mailpit) service=mailpit; port=8025 ;;
    adminer) service=adminer; port=8080 ;;
    dozzle) service=dozzle; port=8080 ;;
    rabbitmq) service=rabbitmq; port=15672 ;;
    meili|meilisearch) service=meilisearch; port=7700 ;;
    *)
      echo "Usage: devhub open [mailpit|adminer|dozzle|rabbitmq|meili]" >&2
      return 1
      ;;
  esac
  config=$(compose_config) || return 1
  published=$(jq -er --arg service "$service" --argjson port "$port" \
    '.services[$service].ports[] | select(.target == $port) | .published' <<<"$config") || return 1
  open_url "http://localhost:$published"
}

postgres_user() {
  local pg_user
  pg_user=$(sed -nE "s/^[[:space:]]*(export[[:space:]]+)?POSTGRES_USER=[\"']?([^\"'#[:space:]]*)[\"']?[[:space:]]*(#.*)?\$/\2/p" "$ENV_FILE" | tail -n1)
  echo "${pg_user:-test}"
}

cmd_db() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    create)
      ensure_network
      COMPOSE_PROFILES="core" dc up -d postgres >/dev/null
      POSTGRES_ADMIN_USER="${POSTGRES_ADMIN_USER:-$(postgres_user)}" "$SCRIPTS_DIR/create-project-db.sh" "$@"
      ;;
    provision)
      POSTGRES_ADMIN_USER="${POSTGRES_ADMIN_USER:-$(postgres_user)}" "$SCRIPTS_DIR/provision-project-db.sh" "$@"
      ;;
    import)
      local importer="${DEVHUB_IMPORT_SCRIPT:-$SCRIPTS_DIR/import-db.sh}"
      [ -x "$importer" ] || { echo "DB importer not found or not executable: $importer" >&2; echo "Place a custom script at $SCRIPTS_DIR/import-db.sh or set DEVHUB_IMPORT_SCRIPT." >&2; exit 1; }
      ensure_network
      COMPOSE_PROFILES="core" dc up -d mysql >/dev/null
      "$importer" "${1:-all}"
      ;;
    list)
      local pg_user
      pg_user=$(postgres_user)
      docker exec "$POSTGRES_CONTAINER" psql -U "$pg_user" -d postgres -Atc "SELECT datname FROM pg_database WHERE datistemplate=false ORDER BY datname;"
      ;;
    *)
      echo "Usage: devhub db [create <db_name> [db_user] [db_password]|provision <db_name> <env_file>|import [trading|distribution|all]|list]" >&2
      exit 1
      ;;
  esac
}

cmd_doctor() {
  local status=0 config
  config=$(compose_config) || return 1
  echo "DevHub directory: $DEVHUB_DIR"
  echo "Compose file: $COMPOSE_FILE"
  echo "Network: $NETWORK_NAME"
  echo ""
  echo "Docker network status:"
  docker network inspect "$NETWORK_NAME" --format '{{.Name}} (driver={{.Driver}})' || status=1
  echo ""
  echo "Container health summary:"
  "$SCRIPTS_DIR/healthcheck.sh" || status=1
  echo ""
  echo "Host ports:"
  print_ports "$config" || status=1
  return "$status"
}

cmd_help() {
  cat <<'EOF'
Usage: devhub <command> [options]

Commands:
  up [--with profile[,profile]]        Start shared services (default: core,async)
  down                                Stop/remove shared services
  restart                             Restart shared services (core,async)
  ps                                  Show service status
  logs [service]                      Follow logs
  open <target>                       Open service URL
  db create <db> [user] [password]    Create project database/user
  db provision <db> <env_file>        Create a private database and role from an env file
  db import [args]                     Run custom DB import script (see DEVHUB_IMPORT_SCRIPT)
  db list                             List non-template databases
  doctor                              Show health and networking diagnostics
  setup [--install-deps]              Check local manager prerequisites
  root | project | maintenance|security Manage approved local projects
  import <path> [--apply]              Run a Hono project in an isolated dev container
  new <stack> <name> --root <path>     Create a project, in Docker or native mode
  presets                             List supported project presets
  versions                            Check pinned versions for end of life and CVEs (needs Go)
  worktree list|add|remove            Run a branch of a Docker project beside it, for a parallel agent
  exec <project> -- <command>         Run a command in the app container of a Docker project
  proxy sync                          Give every project a http://<project>.localhost name (profile proxy)
  mcp                                 MCP server on stdio for coding agents
  serve | pair                        Start the panel API (--dev adds Vite) or create a pairing code
  infra <legacy-command>              Run an existing infrastructure command
  version                             Show the installed DevHub version
  help                                Show this help

Profiles:
  core, async (started by default), proxy (Caddy: http://<project>.localhost)

EOF
}

cmd_version() {
  if [ -f "$VERSION_FILE" ]; then
    tr -d '[:space:]' < "$VERSION_FILE"
    echo
  else
    echo "unknown"
  fi
}

main() {
  local cmd="${1:-help}"
  shift || true

  case "$cmd" in
    root|project|import|new|maintenance|security|setup|serve|pair|presets|versions|worktree|exec|proxy|mcp)
      command -v bun >/dev/null 2>&1 || { echo "Bun is required for '$cmd'. Install it for your user with: curl -fsSL https://bun.sh/install | bash" >&2; exit 1; }
      exec bun "$DEVHUB_CHECKOUT_DIR/src/main.ts" "$cmd" "$@"
      ;;
    infra)
      cmd="${1:-help}"
      [ "$#" -gt 0 ] && shift
      ;;
  esac

  case "$cmd" in
    help|-h|--help)
      cmd_help
      exit 0
      ;;
    version|--version|-v)
      cmd_version
      exit 0
      ;;
    up|down|restart|ps|logs|open|db|doctor) ;;
    *)
      echo "Unknown command: $cmd" >&2
      cmd_help
      exit 1
      ;;
  esac

  require_cmd docker
  case "$cmd" in open|doctor) require_cmd jq ;; esac
  # Diagnostics must not create local configuration on a fresh checkout.
  if [ "$cmd" = doctor ] && [ ! -f "$ENV_FILE" ]; then
    ENV_FILE="$DEVHUB_DIR/.env.example"
  fi
  ensure_files

  case "$cmd" in
    up) cmd_up "$@" ;;
    down) cmd_down ;;
    restart) cmd_restart "$@" ;;
    ps) cmd_ps ;;
    logs) cmd_logs "$@" ;;
    open) cmd_open "$@" ;;
    db) cmd_db "$@" ;;
    doctor) cmd_doctor ;;
  esac
}

main "$@"
